# ── Python ──────────────────────────────────────────────────────────────────
.venv/
__pycache__/
*.pyc
*.egg-info/
.DS_Store

# ── Secrets ─────────────────────────────────────────────────────────────────
.env
.env.*
!.env.example
!.env.local.example

# ── Documentation source propriétaire — JAMAIS dans le repo ─────────────────
french/
ManuelOpenSource/
*.htm
*.html

# ── Données CHU — propriété du service de biologie médicale ─────────────────
fonctions_mispl.xlsx
*.xlsx

