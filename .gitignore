docs/chunks/vectorstore/
docs/chunks/bm25_corpus.json
docs/chunks/manifest*.json
*.bin
*.pickle
chroma.sqlite3

# ── Outputs et rapports générés ─────────────────────────────────────────────
outputs/sessions/
outputs/cache/
outputs/*.json
# Rapports de monitoring ressources (données machine locales, régénérables)
outputs/monitoring/*.html
outputs/monitoring/*.json

# ── Binaires lourds ─────────────────────────────────────────────────────────
*.mp4
*.pdf
*.exe
*.iso

# ── Temporaires éditeur ─────────────────────────────────────────────────────
*.tmp*
*.bak
*~

# ── Base de données locale (comptes, sessions) — jamais dans le repo ────────
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm

# ── Worktrees Claude Code (isolation de branches) ────────────────────────────
.claude/worktrees/

# ── Scratch superpowers (ledgers SDD, maquettes brainstorming) ──────────────
.superpowers/

# Audit PI (contient le texte intégral du manuel GLIMS et des caches) : ne jamais versionner
docs/audit_PI_*/

# Notes internes DSI / juridiques : jamais versionnées (dépôt public)
DSI/

# ── Documentation Sphinx générée — reconstruire via sphinx-build ────────────
docs/sphinx/_build/
# Miroir de sources copiées par conf.py au moment du build (docs/specifications/,
# docs/architecture/, docs/guides/, docs/base_de_donnees/, docs/cartographie/,
# docs/securite/) — les fichiers d'origine restent la source de vérité versionnée.
docs/sphinx/_src_*/

# Sorties locales (banc de test, sessions, évaluations)
outputs/
