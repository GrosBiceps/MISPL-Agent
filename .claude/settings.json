      "Write(outputs/**)",
      "Write(docs/chunks/**)",
      "Write(.claude/**)",
      "Edit(outputs/**)",
      "Edit(.claude/**)",
      "Edit(src/**)"
    ],
    "deny": [
      "Bash(rm -rf*)",
      "Bash(git push --force*)"
    ]
