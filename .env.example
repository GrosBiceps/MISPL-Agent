# Copier ce fichier en .env et remplir les valeurs
# PowerShell : Copy-Item .env.example .env

# Clé API OpenRouter (gratuit) — https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Optionnel : OpenAI embeddings (meilleure qualité sémantique, payant)
# OPENAI_API_KEY=sk-...

# Forcer UTF-8 sur Windows (obligatoire pour les caractères spéciaux)
PYTHONUTF8=1

# Mode d'accès DSI — NE PAS remplir à la main : lancer
# `python scripts/set_dsi_password.py` pour générer ces deux valeurs.
# Sans elles, le mode DSI est inatteignable (fail-safe : mode Technicien seul).
# MISPL_DSI_PASSWORD_SALT=
# MISPL_DSI_PASSWORD_HASH=

# Optionnel : désactive le monitoring ressources (CPU/RAM/disque/réseau)
# MISPL_MONITOR=1

# Optionnel : rétention des sessions journalisées (jours) avant purge auto
# MISPL_SESSION_RETENTION_DAYS=30
