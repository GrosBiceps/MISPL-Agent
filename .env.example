# Copier ce fichier en .env et remplir les valeurs
# PowerShell : Copy-Item .env.example .env

# Clé API OpenRouter (gratuit) — https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Optionnel : OpenAI embeddings (meilleure qualité sémantique, payant)
# OPENAI_API_KEY=sk-...

# Forcer UTF-8 sur Windows (obligatoire pour les caractères spéciaux)
PYTHONUTF8=1

# Mode d'accès DSI (interface Streamlit) — NE PAS remplir à la main : lancer
# `python scripts/set_dsi_password.py`, qui écrit un hash Argon2id (sel inclus)
# entre apostrophes. Sans lui, le mode DSI est inatteignable (fail-safe :
# mode Technicien seul). L'ancien format PBKDF2 (hash hexadécimal +
# MISPL_DSI_PASSWORD_SALT) est encore accepté mais doit être regénéré.
# MISPL_DSI_PASSWORD_HASH=

# Optionnel : destination du LLM. Défaut : OpenRouter. Boucle locale
# (127.0.0.1, localhost) toujours acceptée ; tout autre hôte doit être en
# HTTPS ET listé dans MISPL_LLM_ALLOWED_HOSTS (questions et clé API y sont
# envoyées : validation RSSI requise).
# MISPL_LLM_BASE_URL=
# MISPL_LLM_ALLOWED_HOSTS=

# Optionnel : désactive le monitoring ressources (CPU/RAM/disque/réseau)
# MISPL_MONITOR=1

# Optionnel : rétention des sessions journalisées (jours) avant purge auto
# MISPL_SESSION_RETENTION_DAYS=30

# Optionnel : précharge le RAG (retriever + reranker) au démarrage de l'API.
# Défaut : activé. Mettre false pour un démarrage rapide en développement
# (la première question paie alors tout le chargement).
# MISPL_PRELOAD_RETRIEVER=

# ── API (FastAPI) ──────────────────────────────────────────────────────────────
# Origines autorisées du frontend (CORS, séparées par des virgules). « * » refusé.
# MISPL_FRONTEND_ORIGIN=http://localhost:3000
# Cookie de session Secure (HTTPS). Défaut : true. Ne mettre false qu'en développement local.
# MISPL_COOKIE_SECURE=true
# Rétention du cache de réponses (heures) avant purge au démarrage.
# MISPL_CACHE_RETENTION_HOURS=24
